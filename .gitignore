.env
# ...and any copy of it. A backup taken before editing settings carries the
# same credentials as the original, and `.env` alone does not match `.env.bak`.
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Real cloud credentials (OCI API key etc.) — never commit. Mounted into the
# orchestrator read-only (2.6a).
secrets/

# Terraform working state / provider downloads.
orchestrator/terraform/.terraform/
orchestrator/terraform/.terraform.lock.hcl
orchestrator/terraform/terraform.tfvars.json
orchestrator/terraform/*.tfstate
orchestrator/terraform/*.tfstate.*

# Local database dumps taken before destructive changes. They contain request
# rows and requester email addresses, so they stay out of git the same as .env.
backups/

# Microsoft Office lock files, created while a document is open.
# They are transient and machine-local; committing one confuses the next
# person to open the file.
~$*
scripts/_slide_geometry.json
