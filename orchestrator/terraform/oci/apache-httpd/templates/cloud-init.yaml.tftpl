#cloud-config
# Cloud-init configuration that installs and configures Apache HTTP Server.
# Rendered by Terraform (templatefile) and passed as base64 user_data.
#
# EVERY NAME AND PATH BELOW DIFFERS BETWEEN OS FAMILIES. Apache is `httpd` on
# Oracle Linux and `apache2` on Ubuntu; the systemd unit follows the package
# name; the config file lives in /etc/httpd/conf vs /etc/apache2; the firewall is
# firewalld vs ufw; TLS certificates go to /etc/pki/tls vs /etc/ssl; and Debian
# needs `a2enmod ssl` where Red Hat's mod_ssl package enables itself.
#
# This template was Red Hat throughout until the portal began offering Ubuntu
# images. Pointed at Ubuntu it asked apt for a package called `httpd`, found
# none, and left a VM that booted healthy with no web server on it while
# Terraform reported success — the silent-success failure this codebase keeps
# paying for. The family now comes from the image the requester chose.
#
# os_family is "rhel" or "debian"; anything else would have been refused before
# reaching here (api/component_options.installable_on).

package_update: true
package_upgrade: false

packages:
%{ if os_family == "debian" ~}
  - apache2
%{ if enable_https ~}
  - openssl
%{ endif ~}
%{ else ~}
  - httpd
%{ if enable_https ~}
  - mod_ssl
  - openssl
%{ endif ~}
%{ endif ~}

write_files:
  - path: /var/www/html/index.html
    encoding: b64
    content: ${index_html_b64}
    owner: root:root
    permissions: '0644'
  # What this machine was asked to be, written before the install so a failure
  # is diagnosable from the VM itself rather than only from the portal.
  - path: /etc/infra-portal-configured
    permissions: '0644'
    content: |
      technologies=apache
      os_family=${os_family}
      note=Written before install; presence alone does not prove success.
%{ if boot_report_url != "" ~}
  # The machine's own evidence, PUT to Object Storage at the end of first boot.
  #
  # This blueprint renders its OWN cloud-init and never calls
  # orchestrator/configure.py, so the self-report added there did not reach an
  # Apache machine at all — the same split that let this template stay Red Hat
  # only while the generic path learned about Ubuntu. Caught in pre-flight for
  # REQ-2026-0134, before it cost a VM.
  #
  # The package and unit names arrive as ALREADY-RESOLVED strings. A Terraform
  # conditional directive cannot be used inside a literal block: its line sits at
  # column zero, which ends the block and breaks the document — which is exactly
  # what the first version of this did. (Nor can one be named in a comment: the
  # whole file is a template, so a directive in a YAML comment is still parsed.
  # That was the second version's mistake.)
  - path: /usr/local/bin/infra-portal-report.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      REPORT=/var/log/infra-portal-report.txt
      {
        echo 'os_family=${os_family}'
        echo 'technologies=apache'
        . /etc/os-release 2>/dev/null && echo "os=$PRETTY_NAME"
        echo '--- packages ---'
        (rpm -q ${apache_package} 2>/dev/null || dpkg-query -W -f='${apache_package} $${Version}' ${apache_package} 2>/dev/null || echo '${apache_package} NOT INSTALLED')
        echo ''
        echo '--- services ---'
        echo "${apache_service}=$(systemctl is-active ${apache_service} 2>&1)"
        echo '--- ports ---'
        echo "http_80=$(curl -s -o /dev/null -m 5 -w '%%{http_code}' http://localhost/ 2>&1)"
        ss -lnt 2>/dev/null | grep ':80 ' || echo 'nothing listening on 80'
        # curl-to-localhost and ss both look at the DAEMON, and both pass on a
        # machine nobody can reach — which is exactly what REQ-2026-0136 did.
        # So ask the firewall itself. Testing the machine's own private IP would
        # not do either: that traffic arrives on lo, which both images accept
        # before any port rule is consulted.
        if ${firewall_query} >/dev/null 2>&1; then echo 'firewall_80=open'; else echo 'firewall_80=CLOSED'; fi
        echo '--- first-boot log ---'
        cat /var/log/infra-portal.log 2>/dev/null || echo '(no portal log written)'
      } > $REPORT 2>&1
      curl -s -X PUT --data-binary @$REPORT '${boot_report_url}' >/dev/null 2>&1 || true
%{ endif ~}

runcmd:
%{ if os_family == "debian" ~}
  # --- Ubuntu / Debian -------------------------------------------------------
%{ if server_name != "" ~}
  - "grep -q '^ServerName ' /etc/apache2/apache2.conf || echo 'ServerName ${server_name}' >> /etc/apache2/apache2.conf"
%{ endif ~}
  - "systemctl enable --now apache2 || echo 'PORTAL FAILURE: apache2 did not start' >> /var/log/infra-portal.log"
  # OCI's Ubuntu images DO NOT SHIP ufw. The note that used to sit here said they
  # did, and that `ufw allow` records the rule either way; both halves were wrong.
  # These images filter with iptables rules in /etc/iptables/rules.v4 that REJECT
  # everything but SSH, so the command failed and the reject rule stayed.
  #
  # That is REQ-2026-0136: nginx installed, running, listening on :80, and
  # unreachable from every other machine on its subnet — reported provisioned.
  # ufw is still preferred where it is genuinely present AND active, because raw
  # iptables rules are wiped by its next reload.
  - "(command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q active && ufw allow 80/tcp) || iptables -I INPUT -p tcp --dport 80 -j ACCEPT || echo 'PORTAL FAILURE: could not open 80/tcp in the firewall' >> /var/log/infra-portal.log"
  - "netfilter-persistent save 2>/dev/null || iptables-save > /etc/iptables/rules.v4 2>/dev/null || true"
%{ if enable_https ~}
  - "(command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q active && ufw allow 443/tcp) || iptables -I INPUT -p tcp --dport 443 -j ACCEPT || echo 'PORTAL FAILURE: could not open 443/tcp in the firewall' >> /var/log/infra-portal.log"
  # Debian ships mod_ssl inside the apache2 package but leaves it disabled.
  - "a2enmod ssl || echo 'PORTAL FAILURE: could not enable the ssl module' >> /var/log/infra-portal.log"
  - |
    openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
      -keyout /etc/ssl/private/ssl-cert-snakeoil.key \
      -out /etc/ssl/certs/ssl-cert-snakeoil.pem \
      -subj "/CN=${server_name != "" ? server_name : "localhost"}"
  - "chmod 600 /etc/ssl/private/ssl-cert-snakeoil.key"
  - "a2ensite default-ssl || echo 'PORTAL FAILURE: could not enable the TLS site' >> /var/log/infra-portal.log"
%{ endif ~}
  - "systemctl restart apache2 || echo 'PORTAL FAILURE: apache2 did not restart' >> /var/log/infra-portal.log"
%{ else ~}
  # --- Oracle Linux / Red Hat ------------------------------------------------
%{ if server_name != "" ~}
  - "grep -q '^ServerName ' /etc/httpd/conf/httpd.conf || echo 'ServerName ${server_name}' >> /etc/httpd/conf/httpd.conf"
%{ endif ~}
  - "systemctl enable --now httpd || echo 'PORTAL FAILURE: httpd did not start' >> /var/log/infra-portal.log"
  - "firewall-cmd --permanent --add-service=http || echo 'PORTAL FAILURE: could not open http' >> /var/log/infra-portal.log"
%{ if enable_https ~}
  - "firewall-cmd --permanent --add-service=https || echo 'PORTAL FAILURE: could not open https' >> /var/log/infra-portal.log"
  # Generate a self-signed certificate at the paths mod_ssl uses by default
  - |
    openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
      -keyout /etc/pki/tls/private/localhost.key \
      -out /etc/pki/tls/certs/localhost.crt \
      -subj "/CN=${server_name != "" ? server_name : "localhost"}"
  - "chmod 600 /etc/pki/tls/private/localhost.key"
%{ endif ~}
  - "firewall-cmd --reload || true"
  - "systemctl restart httpd || echo 'PORTAL FAILURE: httpd did not restart' >> /var/log/infra-portal.log"
%{ endif ~}
  - "echo 'PORTAL: first-boot configuration finished' >> /var/log/infra-portal.log"
%{ if boot_report_url != "" ~}
  - "/usr/local/bin/infra-portal-report.sh || true"
%{ endif ~}
