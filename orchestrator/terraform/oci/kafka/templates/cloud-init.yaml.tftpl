#cloud-config
# Installs Apache Kafka in KRaft mode. Rendered per node by Terraform
# (templatefile) and passed as base64 user_data.
#
# Kafka is not in the OS repositories: it is an archive fetched from
# source_url. The JDK is, so it comes from dnf.

package_update: true
package_upgrade: false

packages:
  - ${java_package}
  - tar

write_files:
  # The broker's configuration. node_id and advertised.listeners differ per node;
  # the quorum voter list and cluster id are identical across the cluster.
  - path: /opt/kafka-portal/server.properties
    owner: root:root
    permissions: '0644'
    content: |
      process.roles=broker,controller
      node.id=${node_id}
      controller.quorum.voters=${quorum_voters}
      controller.listener.names=CONTROLLER
      listeners=PLAINTEXT://:${client_port},CONTROLLER://:${controller_port}
      advertised.listeners=PLAINTEXT://${advertised_host}:${client_port}
      listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      inter.broker.listener.name=PLAINTEXT
      log.dirs=/var/lib/kafka/data
      num.partitions=${num_partitions}
      default.replication.factor=${replication_factor}
      offsets.topic.replication.factor=${replication_factor}
      transaction.state.log.replication.factor=${replication_factor}
      transaction.state.log.min.isr=${min_isr}
      auto.create.topics.enable=true

  - path: /etc/kafka-portal.env
    owner: root:root
    permissions: '0644'
    content: |
      KAFKA_HEAP_OPTS=${heap_opts}

  - path: /etc/systemd/system/kafka.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Apache Kafka (KRaft)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=kafka
      Group=kafka
      EnvironmentFile=/etc/kafka-portal.env
      ExecStart=/opt/kafka/bin/kafka-server-start.sh /opt/kafka/config/server.properties
      ExecStop=/opt/kafka/bin/kafka-server-stop.sh
      Restart=on-failure
      RestartSec=15
      LimitNOFILE=100000

      [Install]
      WantedBy=multi-user.target

  # A script rather than a list of runcmd entries, so a failure half way stops
  # the rest instead of leaving a half-installed broker that looks started.
  - path: /opt/kafka-portal/install.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      exec >>/var/log/infra-portal.log 2>&1
      echo "PORTAL: kafka install starting $(date -Is)"

      id kafka >/dev/null 2>&1 || useradd --system --shell /sbin/nologin kafka
      mkdir -p /var/lib/kafka/data

      # Retries because a boot-time fetch races the network coming up.
      echo "PORTAL: fetching ${source_url}"
      curl -fsSL --retry 5 --retry-delay 10 --retry-connrefused \
        -o /tmp/kafka.tgz "${source_url}"

      tar -xzf /tmp/kafka.tgz -C /opt
      rm -f /tmp/kafka.tgz
      ln -sfn /opt/${archive_name} /opt/kafka
      install -m 0644 /opt/kafka-portal/server.properties /opt/kafka/config/server.properties
      chown -R kafka:kafka /opt/${archive_name} /var/lib/kafka

      # Formatting is once-only: doing it again would wipe the log directory, so
      # a reboot must not repeat it.
      if [ ! -f /var/lib/kafka/data/meta.properties ]; then
        echo "PORTAL: formatting storage with cluster id ${cluster_id}"
        runuser -u kafka -- /opt/kafka/bin/kafka-storage.sh format \
          -t "${cluster_id}" -c /opt/kafka/config/server.properties
      else
        echo "PORTAL: storage already formatted, leaving it alone"
      fi

      systemctl daemon-reload
      systemctl enable --now kafka
      echo "PORTAL: kafka install finished $(date -Is)"

%{ if boot_report_url != "" ~}
  - path: /usr/local/bin/infra-portal-report.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      # WAIT BEFORE JUDGING.
      #
      # This script runs in `runcmd` immediately after install.sh, which ends
      # with `systemctl enable --now kafka`. Kafka in KRaft mode takes tens of
      # seconds to form its quorum and bind, so the report was sampling the
      # ports a few seconds after the broker was told to start and recording
      # "nothing listening" about a broker that was still coming up.
      #
      # REQ-2026-0243 failed exactly there: Java installed, the archive fetched,
      # the metadata directory formatted, the unit enabled and active -- and
      # both ports reported empty, 6m22s of real machine spent to learn nothing.
      #
      # The same defect the container path had, fixed the same way: wait for the
      # thing to be ready, then report what is true. A bounded wait -- a broker
      # that has not bound in three minutes is not slow, it is broken, and the
      # log capture below is what says why.
      READY=
      DEADLINE=$(( $(date +%s) + 180 ))
      while [ "$(date +%s)" -lt "$DEADLINE" ]; do
        if ss -lnt 2>/dev/null | grep -q ':${client_port} ' \
           && ss -lnt 2>/dev/null | grep -q ':${controller_port} '; then
          READY=1
          break
        fi
        sleep 5
      done
      REPORT=/var/log/infra-portal-report.txt
      {
        echo 'os_family=rhel'
        echo 'technologies=kafka'
        echo 'node=${node_id}'
        # GUARDED, because a failed `.` is FATAL in POSIX sh: the shell exits
        # on the spot and `2>/dev/null` hides the message without
        # preventing it. On an image without /etc/os-release the report
        # would stop after three lines and the machine would be judged as
        # having no packages, no services and no ports -- a false failure
        # with no trace of why.
        ([ -r /etc/os-release ] && . /etc/os-release && echo "os=$PRETTY_NAME") || echo "os=unknown"
        echo '--- packages ---'
        (rpm -q ${java_package} 2>/dev/null || echo '${java_package} NOT INSTALLED')
        (test -x /opt/kafka/bin/kafka-server-start.sh && echo "kafka $(readlink -f /opt/kafka)" || echo 'kafka NOT INSTALLED')
        echo '--- services ---'
        echo "kafka=$(systemctl is-active kafka 2>&1)"
        echo '--- ports ---'
        ss -lnt 2>/dev/null | grep ':${client_port} ' || echo 'nothing listening on ${client_port}'
        ss -lnt 2>/dev/null | grep ':${controller_port} ' || echo 'nothing listening on ${controller_port}'
        # ss shows the DAEMON is bound. It says nothing about whether the
        # machine's firewall lets anyone else connect — the two came apart on
        # REQ-2026-0136, which listened on :80 and rejected every client.
        # Kafka is Red Hat only, so firewalld answers directly.
        for P in ${client_port} ${controller_port}; do
          if firewall-cmd --query-port=$P/tcp >/dev/null 2>&1; then echo "firewall_$P=open"; else echo "firewall_$P=CLOSED"; fi
        done
        # WHY IT IS NOT LISTENING, IN KAFKA'S OWN WORDS.
        #
        # `systemctl is-active` cannot answer this. The unit is Type=simple with
        # Restart=on-failure, so systemd reports `active` the instant the process
        # is spawned and a crash-looping broker reads exactly like a healthy one
        # -- which is what REQ-2026-0243's report showed: active, and nothing
        # listening on either port.
        #
        # Captured ONLY when the wait above gave up, so a healthy machine's
        # report does not carry forty lines of noise. This is the change that
        # made container failures diagnosable: twice in one afternoon it
        # corrected a confident wrong guess about why a service would not start.
        if [ -z "$READY" ]; then
          echo '--- kafka log (never bound its ports) ---'
          journalctl -u kafka --no-pager -n 40 > /tmp/kafka-journal 2>/dev/null || true
          if [ -s /tmp/kafka-journal ]; then
            sed 's|^|  kafka: |' /tmp/kafka-journal
          else
            echo '  (no journal for kafka)'
          fi
          tail -n 20 /opt/kafka/logs/server.log 2>/dev/null | sed 's|^|  server.log: |'
        fi
        echo '--- first-boot log ---'
        cat /var/log/infra-portal.log 2>/dev/null || echo '(no portal log written)'
      } > $REPORT 2>&1
      curl -s -X PUT --data-binary @$REPORT '${boot_report_url}' >/dev/null 2>&1 || true
%{ endif ~}

runcmd:
  - "/opt/kafka-portal/install.sh || echo 'PORTAL FAILURE: kafka install did not complete - see /var/log/infra-portal.log' >> /var/log/infra-portal.log"
  - "firewall-cmd --permanent --add-port=${client_port}/tcp || echo 'PORTAL FAILURE: could not open ${client_port}/tcp' >> /var/log/infra-portal.log"
  - "firewall-cmd --permanent --add-port=${controller_port}/tcp || echo 'PORTAL FAILURE: could not open ${controller_port}/tcp' >> /var/log/infra-portal.log"
  - "firewall-cmd --reload || true"
%{ if boot_report_url != "" ~}
  - "/usr/local/bin/infra-portal-report.sh || true"
%{ endif ~}
