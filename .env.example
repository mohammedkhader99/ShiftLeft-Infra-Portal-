# Copy this file to .env and adjust values. Never commit the real .env file.

# Master switch: when true, the system uses mock adapters (no real Jira,
# cloud, or provisioning calls). Must stay true until Phase 2.
USE_MOCK=true

# PostgreSQL settings used by docker-compose.yml (increment 0.2 onwards).
# Put a REAL password only in your local .env, never here. This file ships
# placeholders so no secret is ever committed to git.
POSTGRES_DB=infra_portal
POSTGRES_USER=infra_portal
POSTGRES_PASSWORD=change-me-in-your-local-.env

# Shared secret for signing the approval->orchestrator webhook (1.9).
# Put a real random value only in your local .env; a vault provides it in prod.
WEBHOOK_SECRET=change-me-in-your-local-.env

# Per-adapter switches. "mock" uses the seeded rate cards (default); "live"
# prices from the cloud's public price API (needs internet, no credentials).
# On-prem always stays on the seeded rates.
AZURE_PRICING_MODE=mock
OCI_PRICING_MODE=mock

# Sign-in (2.3a). "mock" = local dev login (default). For real Microsoft Entra
# ID sign-in, set live and fill the OIDC_* values from your Entra "app
# registration" (your identity admin provides these). SESSION_SECRET signs the
# login cookie — use a long random value; keep it only in your local .env.
AUTH_MODE=mock
SESSION_SECRET=change-me-to-a-long-random-value
OIDC_TENANT_ID=your-entra-directory-tenant-id
OIDC_CLIENT_ID=your-entra-application-client-id
OIDC_CLIENT_SECRET=your-entra-client-secret
OIDC_REDIRECT_URI=https://your-portal/auth/callback

# Jira (2.4). "mock" = fake tickets (default). For real Jira Server/Data
# Centre, set live and provide these. JIRA_PAT is a Personal Access Token for
# a service account with Create Issues + Modify Reporter permission — keep it
# only in your local .env. The APPROVED/REJECTED statuses must match your
# project's workflow status names.
JIRA_MODE=mock
JIRA_BASE_URL=https://jira.your-domain.com
JIRA_PAT=your-service-account-personal-access-token
JIRA_PROJECT_KEY=INFRA
JIRA_ISSUE_TYPE=Service Request
# Status names in YOUR Jira workflow. Approved = ticket is ready to provision;
# the portal transitions the ticket to IN_PROGRESS when provisioning starts and
# RESOLVED when it finishes. Adjust to match your workflow exactly.
JIRA_APPROVED_STATUSES=Assigned
JIRA_REJECTED_STATUSES=Rejected,Cancelled
JIRA_INPROGRESS_STATUS=In Progress
JIRA_RESOLVED_STATUS=Resolved
# Fields the Resolve transition requires, as one line of JSON (your workflow may
# require a Solution, Closure Reason, etc.), e.g.
# JIRA_RESOLVE_FIELDS={"customfield_14608":"Provisioned by the portal.","customfield_14509":{"value":"Configuration change applied"}}
JIRA_RESOLVE_FIELDS=
JIRA_SET_REPORTER=true
# Replicate a real ticket's create-screen fields automatically (incl. Insight
# asset fields). Point at a known-good ticket in the target project/issue type.
JIRA_TEMPLATE_ISSUE=SDIMD-68275
# Optional JSON overrides applied on top of the template (rarely needed), e.g.
# JIRA_EXTRA_FIELDS={"customfield_13210":{"value":"Low"}}
JIRA_EXTRA_FIELDS=

# Role-based access control (E1.1). ROLE_SOURCE=jira resolves each signed-in
# user's roles from their Jira group membership; "mock" (default) uses ROLE_MAP.
# ROLE_MAP is JSON of email -> roles for local/dev, e.g.
#   ROLE_MAP={"admin@you.com":["platform_admin"],"dev@you.com":["requester"]}
# JIRA_ROLE_MAP is JSON of Jira group name -> role (the live source), e.g.
#   JIRA_ROLE_MAP={"IMD-Platform-Admins":"platform_admin","IMD-Auditors":"auditor"}
# Roles: requester, approver, platform_admin, auditor, finops, read_only.
# Fail-safe: an unresolvable user gets read_only. Ask your Jira admin for the
# real group names when switching ROLE_SOURCE=jira.
ROLE_SOURCE=mock
ROLE_MAP=
JIRA_ROLE_MAP=

# Automatic Jira-status poller (2.7). When true, a background thread pulls the
# live Jira status every POLL_INTERVAL_SECONDS and advances approved requests
# automatically (no button click). Jira still holds the approval and the
# orchestrator still re-verifies it. How far it goes is gated by PROVISION_MODE
# below: with "plan" the auto-run stops at the plan; with "apply" it creates the
# real resource end to end. Default off — turn it on deliberately.
AUTO_PROVISION=false
POLL_INTERVAL_SECONDS=30

# Real provisioning (2.6a). "mock" creates nothing (default). "plan" runs a real
# `terraform plan` against your OCI SANDBOX (still creates nothing). "apply"
# creates real resources (2.6b). Provide the OCI values from a least-privilege
# sandbox user; put the private key PEM file in ./secrets/ (git-ignored) and
# point OCI_PRIVATE_KEY_PATH at it inside the container.
PROVISION_MODE=mock
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your-tenancy
OCI_USER_OCID=ocid1.user.oc1..your-sandbox-user
OCI_FINGERPRINT=aa:bb:cc:...:ff
OCI_PRIVATE_KEY_PATH=/secrets/oci_api_key.pem
OCI_REGION=me-dubai-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..your-sandbox-compartment

# Real AWS provisioning (multi-cloud). When a request's deployment target is AWS,
# the orchestrator provisions a private, versioned S3 bucket via Terraform's AWS
# provider — but ONLY in PROVISION_MODE=apply with these credentials set; without
# them a real apply refuses (mock creates nothing). Least-privilege IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
# Optional: customer-managed KMS key ARN for SSE-KMS on the bucket (else SSE-S3).
AWS_KMS_KEY_ARN=

# High availability (F-OPS-01). The API is safe to run as multiple replicas: a
# DB leader lease keeps the background poller running in exactly ONE replica
# (LEADER_LEASE_TTL_SECONDS = how long before a dead leader's lease lapses and a
# standby takes over). Single-instance deployments need none of this.
LEADER_LEASE_TTL_SECONDS=60

# Per-client rate limit (F-SEC-09). RATE_LIMIT_PER_MINUTE=0 disables it.
# RATE_LIMIT_BACKEND: "memory" (default, per-process) or "shared" (a DB counter
# shared across replicas — set this when running >1 API/BFF replica).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BACKEND=memory
# Shared secret the BFF uses to reach the API's internal shared-counter endpoint.
# Required only when RATE_LIMIT_BACKEND=shared on the BFF; set the SAME value on
# the API and the BFF. Leave blank and that endpoint stays disabled (503).
INTERNAL_API_KEY=
