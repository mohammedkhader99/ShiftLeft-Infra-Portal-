# Copy this file to .env and adjust values. Never commit the real .env file.
#
# NOTE (F-OPS-09): the non-secret governance / FinOps / AI settings below —
# SOD_ENFORCED, FOUR_EYES_ENFORCED, APPROVAL_QUORUM, APPROVAL_SLA_HOURS,
# CHANGE_WINDOW_*, TTL_*, BUDGET_*, VARIANCE_ALERT_PCT, QUOTA_ENFORCE, AI_MODE,
# AI_MODEL — can now be changed at runtime from the Admin console's Settings
# panel. A value set there is stored in the database and OVERRIDES the value
# here (precedence: database -> .env -> built-in default); "Reset to .env" in the
# panel removes the override. The values here remain the deploy-time baseline.
#
# Secrets and the security/provisioning switches (AUTH_MODE, USE_MOCK,
# PROVISION_MODE, AUTO_PROVISION, ROLE_SOURCE, credentials, keys) are
# deliberately NOT editable from the portal and are only ever set here/in a vault.

# Master switch: when true, the system uses mock adapters (no real Jira,
# cloud, or provisioning calls). Must stay true until Phase 2.
USE_MOCK=true

# PostgreSQL settings used by docker-compose.yml (increment 0.2 onwards).
# Put a REAL password only in your local .env, never here. This file ships
# placeholders so no secret is ever committed to git.
POSTGRES_DB=infra_portal
POSTGRES_USER=infra_portal
POSTGRES_PASSWORD=change-me-in-your-local-.env

# Shared secret for signing the approval->orchestrator webhook (1.9).
# Put a real random value only in your local .env; a vault provides it in prod.
WEBHOOK_SECRET=change-me-in-your-local-.env

# Per-adapter switches. "mock" uses the seeded rate cards (default); "live"
# prices from the cloud's public price API (needs internet, no credentials).
# On-prem always stays on the seeded rates.
AZURE_PRICING_MODE=mock
OCI_PRICING_MODE=mock

# Sign-in (2.3a). "mock" = local dev login (default). For real Microsoft Entra
# ID sign-in, set live and fill the OIDC_* values from your Entra "app
# registration" (your identity admin provides these). SESSION_SECRET signs the
# login cookie — use a long random value; keep it only in your local .env.
AUTH_MODE=mock
SESSION_SECRET=change-me-to-a-long-random-value
OIDC_TENANT_ID=your-entra-directory-tenant-id
OIDC_CLIENT_ID=your-entra-application-client-id
OIDC_CLIENT_SECRET=your-entra-client-secret
OIDC_REDIRECT_URI=https://your-portal/auth/callback

# Jira (2.4). "mock" = fake tickets (default). For real Jira Server/Data
# Centre, set live and provide these. JIRA_PAT is a Personal Access Token for
# a service account with Create Issues + Modify Reporter permission — keep it
# only in your local .env. The APPROVED/REJECTED statuses must match your
# project's workflow status names.
JIRA_MODE=mock
JIRA_BASE_URL=https://jira.your-domain.com
JIRA_PAT=your-service-account-personal-access-token
JIRA_PROJECT_KEY=INFRA
JIRA_ISSUE_TYPE=Service Request
# Status names in YOUR Jira workflow. Approved = ticket is ready to provision;
# the portal transitions the ticket to IN_PROGRESS when provisioning starts and
# RESOLVED when it finishes. Adjust to match your workflow exactly.
JIRA_APPROVED_STATUSES=Assigned
JIRA_REJECTED_STATUSES=Rejected,Cancelled
JIRA_INPROGRESS_STATUS=In Progress
JIRA_RESOLVED_STATUS=Resolved
# Fields the Resolve transition requires, as one line of JSON (your workflow may
# require a Solution, Closure Reason, etc.), e.g.
# JIRA_RESOLVE_FIELDS={"customfield_14608":"Provisioned by the portal.","customfield_14509":{"value":"Configuration change applied"}}
JIRA_RESOLVE_FIELDS=
JIRA_SET_REPORTER=true
# Replicate a real ticket's create-screen fields automatically (incl. Insight
# asset fields). Point at a known-good ticket in the target project/issue type.
JIRA_TEMPLATE_ISSUE=SDIMD-68275
# Optional JSON overrides applied on top of the template (rarely needed), e.g.
# JIRA_EXTRA_FIELDS={"customfield_13210":{"value":"Low"}}
JIRA_EXTRA_FIELDS=

# Role-based access control (E1.1). ROLE_SOURCE=jira resolves each signed-in
# user's roles from their Jira group membership; "mock" (default) uses ROLE_MAP.
# ROLE_MAP is JSON of email -> roles for local/dev, e.g.
#   ROLE_MAP={"admin@you.com":["platform_admin"],"dev@you.com":["requester"]}
# JIRA_ROLE_MAP is JSON of Jira group name -> role (the live source), e.g.
#   JIRA_ROLE_MAP={"IMD-Platform-Admins":"platform_admin","IMD-Auditors":"auditor"}
# Roles: requester, approver, platform_admin, auditor, finops, read_only.
# Fail-safe: an unresolvable user gets read_only. Ask your Jira admin for the
# real group names when switching ROLE_SOURCE=jira.
ROLE_SOURCE=mock
ROLE_MAP=
JIRA_ROLE_MAP=

# Automatic Jira-status poller (2.7). When true, a background thread pulls the
# live Jira status every POLL_INTERVAL_SECONDS and advances approved requests
# automatically (no button click). Jira still holds the approval and the
# orchestrator still re-verifies it. How far it goes is gated by PROVISION_MODE
# below: with "plan" the auto-run stops at the plan; with "apply" it creates the
# real resource end to end. Default off — turn it on deliberately.
AUTO_PROVISION=false
POLL_INTERVAL_SECONDS=30

# Real provisioning (2.6a). "mock" creates nothing (default). "plan" runs a real
# `terraform plan` against your OCI SANDBOX (still creates nothing). "apply"
# creates real resources (2.6b). Provide the OCI values from a least-privilege
# sandbox user; put the private key PEM file in ./secrets/ (git-ignored) and
# point OCI_PRIVATE_KEY_PATH at it inside the container.
PROVISION_MODE=mock
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your-tenancy
OCI_USER_OCID=ocid1.user.oc1..your-sandbox-user
OCI_FINGERPRINT=aa:bb:cc:...:ff
OCI_PRIVATE_KEY_PATH=/secrets/oci_api_key.pem
OCI_REGION=me-dubai-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..your-sandbox-compartment

# DNS records for environments (GAP-ANALYSIS step 5). A "dns" request names a
# PROVISIONED environment: the requester asks for a host name, it goes through the
# normal validate -> approve -> orchestrator path, and a real record is created.
# This removes one of the most frequent reasons to raise a ticket with the
# infrastructure team.
#
# The record is planned into the TARGET environment's own Terraform workspace, so
# it shares that environment's lifecycle — tearing the environment down removes
# its name too, rather than leaving a record pointing at nothing.
#
# An A record with no explicit value points at the environment's own private IP,
# so nobody has to copy an address around. A CNAME must name its target.
#
# Double-gated: DNS_MODE=live turns on the real path, and OCI_DNS_ENABLED plus a
# zone must both be set or a real apply refuses. Also needs PROVISION_MODE=apply.
#
# UNVERIFIED: no real DNS record has been created — that needs a real zone.
DNS_MODE=mock
OCI_DNS_ENABLED=false
OCI_DNS_ZONE=
OCI_DNS_TTL=300
OCI_DNS_COMPARTMENT_OCID=

# Live capacity reduction (GAP-ANALYSIS step 3). A "reduce" request scales a
# provisioned VM or managed database DOWN for real, by re-planning its Terraform
# workspace with the smaller sizing — Terraform rather than a direct API call, so
# the workspace stays the source of truth and the change doesn't show up as drift.
# Also needs PROVISION_MODE=apply.
#
# A REAL RESIZE RESTARTS THE RESOURCE: a flex-shape change reboots a VM and a
# database shape change restarts the service. The portal says so on the request
# and in the Jira ticket. Off by default.
#
# UNVERIFIED against real infrastructure — the routing, sizing and refusals are
# tested, but no real VM or database has been resized.
REDUCE_MODE=mock
OCI_PSQL_SHAPE_FAMILY=PostgreSQL.VM.Standard.E4.Flex

# First-boot configuration for VM-based technologies (GAP-ANALYSIS step 4).
# Terraform creates a bare VM; this makes it install and enable the requested
# technologies itself at first boot via cloud-init. Cloud-init rather than
# Ansible-over-SSH because the VMs are private-only and the orchestrator sits
# outside the VCN, so it cannot reach them to push configuration.
#
# PREREQUISITE: the private subnet needs egress (a NAT or service gateway) or an
# internal package mirror. Without it the boot-time install fails and you get a
# bare VM — the install is written to fail loudly into /var/log/infra-portal.log
# rather than silently.
#
# Package names depend on YOUR image, so they are data:
#   CONFIG_OS_FAMILY=rhel|debian|suse
#   CONFIG_PACKAGE_MAP={"nginx":{"packages":["nginx-core"],"services":["nginx"]}}
#
# UNVERIFIED: no VM has been booted with this yet. Technologies with a template
# therefore still show as "manual" in the catalogue until one is proven — see
# CONFIG_VERIFIED_CODES in api/fulfilment.py.
CONFIG_ENABLED=false
CONFIG_OS_FAMILY=rhel
CONFIG_PACKAGE_MAP=

# Backup & restore for managed databases (F-LCM-06). "mock" (default) records the
# action and touches no cloud. "live" calls the real OCI API using the same
# credentials the orchestrator already holds for Terraform, and additionally
# requires OCI_PSQL_ENABLED=true.
#
# IMPORTANT — restore is NOT in place. OCI managed PostgreSQL has no rollback:
# restoring a backup creates a SEPARATE database system with its own endpoint and
# leaves the original untouched. The portal says so on the request and in the Jira
# ticket; the application must be repointed at the new endpoint. A restore
# therefore creates a second BILLABLE database system.
#
# UNVERIFIED against a real OCI tenancy — the adapter's logic and refusals are
# tested, but no real backup or restore has been exercised. Try it on a
# throwaway database before relying on it.
BACKUP_MODE=mock
RESTORE_MODE=mock

# Just-in-time credential delivery (F-IAM-07 / F-INT-05). "mock" (default) issues
# a clearly-labelled PLACEHOLDER link — never a real secret. "live" uses
# HashiCorp Vault.
#
# How live mode keeps secrets away from the portal: for each grant the portal
# creates a short-lived CHILD TOKEN, uses it to read the credential with response
# wrapping, and hands the grantee a ONE-TIME link. The portal stores only the
# token accessor — which cannot authenticate — and never sees the credential.
# Revoking that accessor cascades to every lease the token created, so revoke
# genuinely kills the database login (verified end to end; see GAP-ANALYSIS §10).
#
# VAULT_CREDS_PATH is a template ({scope}, {reference}, {grantee}). The default
# uses dynamic per-grant database logins; a kv path works too, e.g.
#   VAULT_CREDS_PATH=kv/data/envs/{reference}/{scope}
# VAULT_GRANT_POLICY must allow reading those paths and nothing more.
VAULT_MODE=mock
VAULT_ADDR=
VAULT_TOKEN=
VAULT_CREDS_PATH=database/creds/{scope}
VAULT_GRANT_POLICY=default
# Optional: Vault Enterprise namespace; a public URL for the unwrap link when the
# grantee reaches Vault on a different address; TLS verification (dev only).
VAULT_NAMESPACE=
VAULT_UI_ADDR=
VAULT_VERIFY=true

# Managed PostgreSQL on OCI (GAP-ANALYSIS.md step 2). When a request's stack
# includes PostgreSQL on OCI, the orchestrator provisions a real OCI Database
# with PostgreSQL system — the requester gets an actual database rather than a
# placeholder bucket.
#
# DOUBLE-GATED ON PURPOSE. This portal can run autonomously (AUTO_PROVISION +
# PROVISION_MODE=apply) and a managed DB system is BILLABLE (roughly USD 200-400
# per month per instance, depending on shape). So it needs BOTH an explicit
# opt-in AND the infrastructure inputs; without them a real apply refuses with a
# clear message instead of quietly creating a database.
#
# The admin password is NEVER given to the portal. Create the secret in OCI Vault
# yourself and put only its SECRET OCID here — Terraform passes the reference, so
# the password never reaches the plan file, the state, or this repository.
OCI_PSQL_ENABLED=false
OCI_PSQL_SUBNET_OCID=
OCI_PSQL_ADMIN_SECRET_OCID=
# Optional: separate compartment for databases (empty = OCI_COMPARTMENT_OCID).
OCI_PSQL_COMPARTMENT_OCID=
OCI_PSQL_VERSION=14
OCI_PSQL_SHAPE=PostgreSQL.VM.Standard.E4.Flex.2.32GB
OCI_PSQL_ADMIN_USERNAME=pgadmin
OCI_PSQL_ADMIN_SECRET_VERSION=1
OCI_PSQL_STORAGE_IOPS=75000

# Real AWS provisioning (multi-cloud). When a request's deployment target is AWS,
# the orchestrator provisions a private, versioned S3 bucket via Terraform's AWS
# provider — but ONLY in PROVISION_MODE=apply with these credentials set; without
# them a real apply refuses (mock creates nothing). Least-privilege IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
# Optional: customer-managed KMS key ARN for SSE-KMS on the bucket (else SSE-S3).
AWS_KMS_KEY_ARN=

# High availability (F-OPS-01). The API is safe to run as multiple replicas: a
# DB leader lease keeps the background poller running in exactly ONE replica
# (LEADER_LEASE_TTL_SECONDS = how long before a dead leader's lease lapses and a
# standby takes over). Single-instance deployments need none of this.
LEADER_LEASE_TTL_SECONDS=60

# Per-client rate limit (F-SEC-09). RATE_LIMIT_PER_MINUTE=0 disables it.
# RATE_LIMIT_BACKEND: "memory" (default, per-process) or "shared" (a DB counter
# shared across replicas — set this when running >1 API/BFF replica).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BACKEND=memory
# Shared secret the BFF uses to reach the API's internal shared-counter endpoint.
# Required only when RATE_LIMIT_BACKEND=shared on the BFF; set the SAME value on
# the API and the BFF. Leave blank and that endpoint stays disabled (503).
INTERNAL_API_KEY=

# --- Cloud option catalogue (hourly cache for the component detail form) -------
# The form's shape/image dropdowns are cached from the tenancy rather than typed
# into code. The ORCHESTRATOR reads the cloud (it holds the credentials); the API
# asks it on a timer and caches the answer, so the form reads the database and
# keeps working when OCI is unreachable.
#
# Read-only: the underlying calls only ever LIST. Nothing here can create,
# change or destroy a resource.
#
# OCI_CATALOGUE_ENABLED (API) starts the refresh thread. Off by default.
OCI_CATALOGUE_ENABLED=false
# How often to re-ask. Floored at 300 — this calls a real cloud API on a timer.
OCI_CATALOGUE_REFRESH_SECONDS=3600
# OCI_CATALOGUE_MODE (orchestrator): mock = a small fixed set, so the whole path
# is demoable without touching the tenancy. live = the real OCI SDK.
OCI_CATALOGUE_MODE=mock
#
# BOTH LISTS BELOW ARE EMPTY ON PURPOSE, AND EMPTY MEANS "OFFER NOTHING".
# A tenancy carries ~100 shapes including bare-metal and GPU machines costing
# thousands a month. Silence must not be read as "offer everything", so an
# unconfigured portal offers none of them and the seeded values stand.
#
# Comma-separated shape names a requester may pick, e.g.
# OCI_SHAPE_ALLOWLIST=VM.Standard.E4.Flex,VM.Standard.E5.Flex
OCI_SHAPE_ALLOWLIST=
# Comma-separated substrings an OS image's display name must contain. A term
# starting with "-" EXCLUDES instead. A substring, not an OCID: Oracle
# republishes platform images with a new OCID every few weeks, so a pinned OCID
# goes stale silently.
#
# The exclusions matter. Oracle publishes these side by side:
#   Oracle-Linux-9.8-2026.07.20-0            <- plain x86, what you usually want
#   Oracle-Linux-9.8-aarch64-2026.07.20-0    <- ARM; fails on an AMD/Intel shape
#   Oracle-Linux-9.8-Gen2-GPU-2026.07.20-0   <- GPU shapes only
# so "Oracle Linux 9, x86" cannot be said with an include-only filter without
# naming the release date, which goes stale on the next publish:
# OCI_IMAGE_FILTER=Oracle-Linux-9,-aarch64,-GPU
OCI_IMAGE_FILTER=
